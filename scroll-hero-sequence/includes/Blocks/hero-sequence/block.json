  "textdomain": "scroll-hero-sequence",
  "attributes": {
    "heroId": {
      "type": "number",
      "default": 0
    }
  },
  "supports": {
    "html": false,
    "align": [ "wide", "full" ]
  },
  "editorScript": "file:./edit.js",
  "render": "file:./render.php"
}
