{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "scroll-hero-sequence/hero-sequence",
  "version": "0.1.0",
  "title": "Scroll Hero Sequence",
  "category": "media",
  "icon": "images-alt2",
  "description": "Cinematic scroll-driven hero with HTML overlays.",
